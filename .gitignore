# ---------------------------------------------------------------------------
# Secrets. Never commit.
# ---------------------------------------------------------------------------
# backend/.env holds the real database password and DJANGO_SECRET_KEY for this
# machine. `.env.example` is committed instead — it documents every variable
# with placeholder values, so a new deployment knows what to set without ever
# having seen a real one.
.env
*.env
!.env.example
!backend/.env.example
backend/.env

# ---------------------------------------------------------------------------
# Virtualenv and Python build output
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# ---------------------------------------------------------------------------
# Uploaded files
# ---------------------------------------------------------------------------
# Invoice attachments and expense receipts are customer data, not source. In
# production these live in object storage; locally they land here.
backend/media/
media/

# Collected static output is a build artefact, regenerated by `collectstatic`.
backend/staticfiles/
staticfiles/

# ---------------------------------------------------------------------------
# Test, cache and tooling
# ---------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.tox/

# ---------------------------------------------------------------------------
# Local databases and logs
# ---------------------------------------------------------------------------
*.sqlite3
*.db
*.log

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Scratch
New Text Document.txt
