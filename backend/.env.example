# Local development configuration. Copy to `.env`. Never commit real secrets.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-not-a-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,testserver

# --- PostgreSQL (required) -------------------------------------------------
# The only service you must install. PostgreSQL 16+.
POSTGRES_DB=erp
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# The application connects as `erp_app`, which is NOT a superuser. This is not
# a hardening nicety, it is the whole isolation model: PostgreSQL skips every
# row-level security policy for a role with rolsuper or rolbypassrls, so an app
# connecting as `postgres` has all 87 policies installed and none of them in
# effect. The ORM keeps filtering, so nothing looks wrong until a `.raw()` or
# an unbound Celery task hands one customer another customer's ledger.
#
# Create the role once (connect as a superuser first, then switch these two
# lines to the values below):
#
#     python manage.py provision_db_roles
#
# Migrations still need DDL rights, so run them as the owner:
#
#     POSTGRES_APP_USER=postgres python manage.py migrate
POSTGRES_APP_USER=erp_app
POSTGRES_APP_PASSWORD=erp_app

# The owner/migrator role. Only `migrate` and `provision_db_roles` use it.
POSTGRES_MIGRATOR_USER=postgres
POSTGRES_MIGRATOR_PASSWORD=change-me

# --- Redis (OPTIONAL) ------------------------------------------------------
# Leave USE_REDIS unset and you need no Redis at all: the cache falls back to
# in-memory and Celery tasks run inline. That is enough to run the API, the
# ledger, payroll and every endpoint.
#
# Set USE_REDIS=1 (and run Redis) when you are working on caching, throttling
# or background workers — those behave differently with a shared store, and
# production uses Redis.
# USE_REDIS=1
# REDIS_URL=redis://127.0.0.1:6379/0
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
